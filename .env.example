# Elasticsearch connection
ES_URL=https://your-cluster:9200
ES_USER=elastic
ES_PASSWORD=changeme
ES_INDEX=bbq
ES_VERIFY_TLS=true

# Temperature units: f (Fahrenheit), c (Celsius), k (Kelvin)
TEMP_UNITS=f

# How often to flush buffered readings to ES (seconds)
BULK_INTERVAL=5

# BLE reconnection settings
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_DELAY=5

# Enable verbose logging
DEBUG=false
