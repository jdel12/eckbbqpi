# Elasticsearch (set ES_PASSWORD to enable)
# ES_URL=https://your-cluster:9200
# ES_USER=elastic
# ES_PASSWORD=
# ES_INDEX=bbq
# ES_VERIFY_TLS=true

# ClickHouse (set CH_URL to enable)
# CH_URL=http://localhost:8123
# CH_USER=default
# CH_PASSWORD=
# CH_DATABASE=bbq
# CH_TABLE=readings

# Temperature units: f (Fahrenheit), c (Celsius), k (Kelvin)
TEMP_UNITS=f

# Seconds between bulk flushes to outputs
BULK_INTERVAL=5

# BLE reconnection
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_DELAY=5

# Verbose logging
# DEBUG=false
